<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Text -->
    <style name="Text">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Text.Display">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="Text.Title">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">22sp</item>
    </style>

    <style name="Text.Heading">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Text.Body">
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="Text.Caption">
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Text.Label">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">6dp</item>
        <item name="android:layout_marginTop">16dp</item>
    </style>

    <style name="Text.Link">
        <item name="android:textColor">@color/green</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">13sp</item>
        <item name="android:padding">4dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="TextAppearance.Kitaab.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <!-- App bar -->
    <style name="Widget.Kitaab.AppBar" parent="Widget.Material3.AppBarLayout">
        <item name="android:background">@color/paper</item>
        <item name="liftOnScroll">false</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Widget.Kitaab.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="titleTextAppearance">@style/TextAppearance.Kitaab.ToolbarTitle</item>
        <item name="titleTextColor">@color/ink</item>
        <item name="navigationIconTint">@color/ink</item>
        <item name="android:background">@color/paper</item>
    </style>

    <style name="Widget.Kitaab.Toolbar.Transparent">
        <item name="android:background">@android:color/transparent</item>
    </style>

    <!-- Buttons -->
    <style name="Widget.Kitaab.Button.Filled" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="backgroundTint">@color/green</item>
        <item name="android:textColor">@color/on_green</item>
        <item name="cornerRadius">@dimen/corner_field</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Kitaab.Button.Accent" parent="Widget.Kitaab.Button.Filled">
        <item name="backgroundTint">@color/rust_fill</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.Kitaab.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="strokeColor">@color/green</item>
        <item name="strokeWidth">1.5dp</item>
        <item name="android:textColor">@color/green</item>
        <item name="cornerRadius">@dimen/corner_field</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Kitaab.Button.Small" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">34dp</item>
        <item name="strokeColor">@color/green</item>
        <item name="android:textColor">@color/green</item>
        <item name="cornerRadius">9dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.Kitaab.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/green</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Text fields -->
    <style name="Widget.Kitaab.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxStrokeColor">@color/til_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_field</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_field</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_field</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_field</item>
        <item name="hintTextColor">@color/green</item>
        <item name="android:textColorHint">@color/ink_soft</item>
        <item name="placeholderTextColor">@color/ink_faint</item>
        <item name="prefixTextColor">@color/ink_soft</item>
        <item name="counterTextColor">@color/ink_soft</item>
    </style>

    <style name="Widget.Kitaab.TextInput.Dropdown" parent="Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu">
        <item name="boxBackgroundColor">@color/surface</item>
        <item name="boxStrokeColor">@color/til_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">@dimen/corner_field</item>
        <item name="boxCornerRadiusTopEnd">@dimen/corner_field</item>
        <item name="boxCornerRadiusBottomStart">@dimen/corner_field</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/corner_field</item>
        <item name="hintTextColor">@color/green</item>
        <item name="android:textColorHint">@color/ink_soft</item>
        <item name="placeholderTextColor">@color/ink_faint</item>
        <item name="prefixTextColor">@color/ink_soft</item>
        <item name="counterTextColor">@color/ink_soft</item>
    </style>

    <!-- Chips -->
    <style name="Widget.Kitaab.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="chipStrokeColor">@color/chip_stroke</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">@dimen/corner_chip</item>
        <item name="chipMinHeight">36dp</item>
        <item name="chipStartPadding">8dp</item>
        <item name="chipEndPadding">8dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Widget.Kitaab.Chip.Assist" parent="Widget.Material3.Chip.Assist">
        <item name="chipBackgroundColor">@color/surface</item>
        <item name="chipStrokeColor">@color/line</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="chipCornerRadius">@dimen/corner_chip</item>
        <item name="chipMinHeight">36dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Small helpers -->
    <style name="Input">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="Row">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/line</item>
    </style>
</resources>
