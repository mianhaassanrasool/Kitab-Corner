<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:layout_marginBottom="@dimen/space_12"
    android:orientation="horizontal"
    android:padding="10dp">
    <FrameLayout
        android:id="@+id/cover"
        android:layout_width="84dp"
        android:layout_height="116dp"
        android:background="@drawable/bg_cover"
        android:backgroundTint="#1F5C4D">
        <View
            android:layout_width="6dp"
            android:layout_height="match_parent"
            android:background="#2E000000" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingBottom="10dp"
            android:paddingEnd="@dimen/space_s"
            android:paddingStart="14dp"
            android:paddingTop="@dimen/space_12">
            <View
                android:layout_width="18dp"
                android:layout_height="2dp"
                android:background="#CCF5F0E6"
                android:layout_marginBottom="6dp" />
            <TextView
                android:id="@+id/cover_title"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:autoSizeMaxTextSize="16sp"
                android:autoSizeMinTextSize="7sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="serif"
                android:gravity="top"
                android:layout_weight="1"
                android:textColor="@color/cover_text"
                android:textStyle="bold"
                tools:text="The Alchemist" />
            <TextView
                android:id="@+id/cover_author"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:autoSizeMaxTextSize="11sp"
                android:autoSizeMinTextSize="5sp"
                android:autoSizeTextType="uniform"
                android:letterSpacing="0.08"
                android:maxLines="1"
                android:textColor="#CCF5F0E6"
                tools:text="PAULO COELHO" />
        </LinearLayout>
    </FrameLayout>
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_12"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            style="@style/Text"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="serif"
            android:maxLines="2"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="The Alchemist" />
        <TextView
            style="@style/Text.Caption"
            android:id="@+id/author"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            tools:text="Paulo Coelho" />
        <TextView
            android:id="@+id/condition"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_tag_rust"
            android:layout_marginTop="@dimen/space_s"
            android:paddingBottom="2dp"
            android:paddingEnd="6dp"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:textColor="@color/rust"
            android:textSize="10sp"
            android:textStyle="bold"
            tools:text="GOOD" />
        <TextView
            style="@style/Text"
            android:id="@+id/price"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:textColor="@color/green"
            android:textSize="17sp"
            android:textStyle="bold"
            tools:text="Rs 650" />
        <TextView
            style="@style/Text.Caption"
            android:id="@+id/city"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:textSize="11sp"
            tools:text="Clifton, Karachi  ·  5 hrs ago" />
    </LinearLayout>
    <ImageView
        android:id="@+id/heart"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@string/row_book_card_save"
        android:padding="7dp"
        android:src="@drawable/ic_heart_outline" />
</LinearLayout>
