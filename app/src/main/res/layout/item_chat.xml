<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingBottom="@dimen/space_12"
    android:paddingEnd="@dimen/page_margin"
    android:paddingStart="@dimen/page_margin"
    android:paddingTop="@dimen/space_12">
    <TextView
        android:id="@+id/avatar"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_avatar"
        android:backgroundTint="#1F5C4D"
        android:fontFamily="serif"
        android:gravity="center"
        android:textColor="@color/cover_text"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="AK" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                style="@style/Text"
                android:id="@+id/name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Ayesha Khan" />
            <TextView
                style="@style/Text.Caption"
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="11sp"
                tools:text="4:12 pm" />
        </LinearLayout>
        <TextView
            style="@style/Text.Caption"
            android:id="@+id/book"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:textColor="@color/green"
            android:textSize="11sp"
            tools:text="re: Atomic Habits" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">
            <TextView
                style="@style/Text.Caption"
                android:id="@+id/last"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:layout_weight="1"
                android:maxLines="1"
                android:textSize="13sp"
                tools:text="1,100 and it's yours." />
            <TextView
                android:id="@+id/unread"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:background="@drawable/bg_badge"
                android:gravity="center"
                android:layout_marginStart="@dimen/space_s"
                android:textColor="@color/white"
                android:textSize="10sp"
                android:textStyle="bold"
                tools:text="2" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
