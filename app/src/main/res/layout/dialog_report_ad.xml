<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="vertical"
    android:padding="@dimen/space_l">
    <TextView
        style="@style/Text.Heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/book_detail_report_this_ad" />
    <TextView
        style="@style/Text.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:text="@string/report_ad_tell_us_what_is_wrong_repo" />
    <RadioGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checkedButton="@+id/radioScam"
        android:layout_marginTop="@dimen/space_s">
        <RadioButton
            android:id="@+id/radioScam"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:buttonTint="@color/green"
            android:text="@string/report_ad_scam_or_fake_listing" />
        <RadioButton
            android:id="@+id/radioWrongDetails"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:buttonTint="@color/green"
            android:text="@string/report_ad_wrong_price_or_details" />
        <RadioButton
            android:id="@+id/radioOffensive"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:buttonTint="@color/green"
            android:text="@string/report_ad_offensive_content" />
        <RadioButton
            android:id="@+id/radioSold"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:buttonTint="@color/green"
            android:text="@string/report_ad_book_is_already_sold" />
    </RadioGroup>
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Kitaab.TextInput"
        android:id="@+id/tilMoreDetailsOptional"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/report_ad_more_details_optional"
        android:layout_marginTop="@dimen/space_s">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMoreDetailsOptional"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:minLines="3" />
    </com.google.android.material.textfield.TextInputLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:layout_marginTop="@dimen/space_m"
        android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Kitaab.Button.Text"
            android:id="@+id/btnCancel"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="@string/report_ad_cancel" />
        <com.google.android.material.button.MaterialButton
            style="@style/Widget.Kitaab.Button.Filled"
            android:id="@+id/btnSendReport"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="@dimen/space_s"
            android:text="@string/report_ad_send_report" />
    </LinearLayout>
</LinearLayout>
