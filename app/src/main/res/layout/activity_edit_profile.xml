<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/coordinatorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <com.google.android.material.appbar.AppBarLayout
            style="@style/Widget.Kitaab.AppBar"
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <com.google.android.material.appbar.MaterialToolbar
                style="@style/Widget.Kitaab.Toolbar"
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:navigationContentDescription="@string/sign_up_back"
                app:navigationIcon="@drawable/ic_arrow_back"
                app:title="@string/profile_edit_profile" />
        </com.google.android.material.appbar.AppBarLayout>
        <ScrollView
            android:id="@+id/scrollContent"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:scrollbars="none">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="@dimen/page_margin"
                android:paddingEnd="@dimen/page_margin"
                android:paddingStart="@dimen/page_margin">
                <FrameLayout
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/space_s">
                    <TextView
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:background="@drawable/bg_avatar"
                        android:backgroundTint="#1F5C4D"
                        android:fontFamily="serif"
                        android:gravity="center"
                        android:text="@string/profile_ar"
                        android:textColor="@color/cover_text"
                        android:textSize="32sp"
                        android:textStyle="bold" />
                    <ImageView
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_circle_tint"
                        android:layout_gravity="bottom|end"
                        android:padding="@dimen/space_s"
                        android:src="@drawable/ic_camera" />
                </FrameLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Kitaab.TextInput"
                    android:id="@+id/tilFullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/sign_up_full_name"
                    android:layout_marginTop="@dimen/space_m">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="textPersonName"
                        android:text="@string/profile_ali_raza" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Kitaab.TextInput"
                    android:id="@+id/tilMobileNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/sign_up_mobile_number"
                    android:layout_marginTop="@dimen/space_m">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etMobileNumber"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="phone"
                        android:text="@string/edit_profile_0300_1234567" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Kitaab.TextInput"
                    android:id="@+id/tilEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/edit_profile_email"
                    android:layout_marginTop="@dimen/space_m">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:importantForAutofill="no"
                        android:inputType="textEmailAddress"
                        android:text="@string/profile_ali_raza_gmail_com" />
                </com.google.android.material.textfield.TextInputLayout>
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Kitaab.TextInput"
                    android:id="@+id/tilAboutYou"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/edit_profile_about_you"
                    android:layout_marginTop="@dimen/space_m">
                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etAboutYou"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:importantForAutofill="no"
                        android:inputType="textMultiLine"
                        android:minLines="3"
                        android:text="@string/edit_profile_cs_student_at_fast_i_read" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </ScrollView>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bar_top"
            android:padding="@dimen/space_m">
            <com.google.android.material.button.MaterialButton
                style="@style/Widget.Kitaab.Button.Filled"
                android:id="@+id/btnSaveChanges"
                android:text="@string/edit_profile_save_changes" />
        </LinearLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
