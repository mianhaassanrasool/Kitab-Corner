<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/surface"
    android:orientation="vertical"
    android:paddingBottom="@dimen/space_l"
    android:paddingEnd="@dimen/space_l"
    android:paddingStart="@dimen/space_l"
    android:paddingTop="@dimen/space_12">
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:background="@color/line"
        android:layout_gravity="center_horizontal" />
    <TextView
        style="@style/Text.Heading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:text="@string/sheet_sort_sort_by" />
    <RadioGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:checkedButton="@+id/radioNewest"
        android:layout_marginTop="@dimen/space_s">
        <RadioButton
            android:id="@+id/radioNewest"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:buttonTint="@color/green"
            android:text="@string/search_newest_first" />
        <RadioButton
            android:id="@+id/radioPriceLow"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:buttonTint="@color/green"
            android:text="@string/sheet_sort_price_low_to_high" />
        <RadioButton
            android:id="@+id/radioPriceHigh"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:buttonTint="@color/green"
            android:text="@string/sheet_sort_price_high_to_low" />
        <RadioButton
            android:id="@+id/radioNearest"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:buttonTint="@color/green"
            android:text="@string/sheet_sort_nearest_to_me" />
    </RadioGroup>
    <com.google.android.material.button.MaterialButton
        style="@style/Widget.Kitaab.Button.Filled"
        android:id="@+id/btnApply"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/space_m"
        android:text="@string/sheet_sort_apply" />
</LinearLayout>
