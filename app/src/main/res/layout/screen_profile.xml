<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp">

                <TextView
                    android:layout_width="68dp"
                    android:layout_height="68dp"
                    android:background="@drawable/bg_avatar"
                    android:backgroundTint="#1F5C4D"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:text="AR"
                    android:textColor="@color/paper"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/Text.Title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ali Raza" />
                    <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="ali.raza@gmail.com" android:textSize="13sp" />
                    <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lahore  ·  Joined Sept 2025" android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    style="@style/Btn.Small"
                    android:tag="go:edit_profile"
                    android:text="Edit" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="20dp"
                android:background="@drawable/bg_card"
                android:orientation="horizontal"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                    <TextView style="@style/Text.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="3" />
                    <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Active ads" />
                </LinearLayout>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/line" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                    <TextView style="@style/Text.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2" />
                    <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sold" />
                </LinearLayout>
                <View android:layout_width="1dp" android:layout_height="match_parent" android:background="@color/line" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center_horizontal" android:orientation="vertical">
                    <TextView style="@style/Text.Heading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Rs 2,350" />
                    <TextView style="@style/Text.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Earned" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingTop="22dp"
                android:paddingBottom="4dp"
                android:text="YOUR STUFF"
                android:textSize="11sp"
                android:textStyle="bold" />
            <View style="@style/Divider" android:layout_marginStart="20dp" />
            <LinearLayout
                style="@style/Row"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:tag="go:my_ads">

                <TextView
                    style="@style/Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="My ads"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_tag_green"
                    android:gravity="center"
                    android:minWidth="22dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="3"
                    android:textColor="@color/green"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>
            <View
                style="@style/Divider"
                android:layout_marginStart="20dp" />
            <LinearLayout
                style="@style/Row"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:tag="go:saved">

                <TextView
                    style="@style/Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Saved books"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_tag_green"
                    android:gravity="center"
                    android:minWidth="22dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="4"
                    android:textColor="@color/green"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>
            <View
                style="@style/Divider"
                android:layout_marginStart="20dp" />
            <LinearLayout
                style="@style/Row"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:tag="go:notifications">

                <TextView
                    style="@style/Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Notifications"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="20dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_tag_green"
                    android:gravity="center"
                    android:minWidth="22dp"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="2"
                    android:textColor="@color/green"
                    android:textSize="11sp"
                    android:textStyle="bold" />
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>
            <View
                style="@style/Divider"
                android:layout_marginStart="20dp" />
            <TextView
                style="@style/Text.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingTop="22dp"
                android:paddingBottom="4dp"
                android:text="ACCOUNT"
                android:textSize="11sp"
                android:textStyle="bold" />
            <View style="@style/Divider" android:layout_marginStart="20dp" />
            <LinearLayout
                style="@style/Row"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:tag="go:edit_profile">

                <TextView
                    style="@style/Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Edit profile"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>
            <View
                style="@style/Divider"
                android:layout_marginStart="20dp" />
            <LinearLayout
                style="@style/Row"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:tag="go:settings">

                <TextView
                    style="@style/Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Settings"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>
            <View
                style="@style/Divider"
                android:layout_marginStart="20dp" />
            <LinearLayout
                style="@style/Row"
                android:paddingStart="20dp"
                android:paddingEnd="16dp">

                <TextView
                    style="@style/Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Invite friends"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />
                <TextView
                    style="@style/Text.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="Earn badges"
                    android:textSize="13sp" />
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>
            <View
                style="@style/Divider"
                android:layout_marginStart="20dp" />
            <LinearLayout
                style="@style/Row"
                android:paddingStart="20dp"
                android:paddingEnd="16dp">

                <TextView
                    style="@style/Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Help and support"
                    android:textColor="@color/ink"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>
            <View
                style="@style/Divider"
                android:layout_marginStart="20dp" />
            <LinearLayout
                style="@style/Row"
                android:paddingStart="20dp"
                android:paddingEnd="16dp"
                android:tag="root:login">

                <TextView
                    style="@style/Text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Log out"
                    android:textColor="@color/danger"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>
            <View
                style="@style/Divider"
                android:layout_marginStart="20dp" />
        </LinearLayout>
    </ScrollView>

    <include layout="@layout/view_bottom_nav" />
</LinearLayout>
